# Text is checked out with LF on every OS, whatever core.autocrlf says. The library writes LF
# everywhere (issue #1659), so a CRLF checkout breaks two things: golden text fixtures no longer
# match its output, and multi-line string literals in .cs files compile with CRLF inside them,
# which changes the bytes the library built from that checkout produces.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to LF on checkout.
*.cs text
*.ps1 text
*.psm1 text
*.psd1 text
*.config text
*.md text
*.txt text
*.xml text
*.resx text

.gitattributes text
.gitignore text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf
*.csproj text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.docx binary
*.odt binary
*.xlsx binary
*.pptx binary



# Recorded Mono AOT profile (scripts/record-aot-profile.sh); opaque bytes, never normalized.
*.aotprofile binary

# Exact ASCII clipboard proof: preserve column padding and LF bytes.
docs/images/arcade-doom-ascii-clipboard.txt text eol=lf whitespace=-blank-at-eol
