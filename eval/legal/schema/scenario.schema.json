{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docxodus.dev/schemas/legal-eval/scenario-2.0.json",
  "title": "Docxodus deterministic legal workflow scenario",
  "$defs": {
    "boundedNonBlankString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    },
    "corpusRelativePath": {
      "allOf": [
        { "$ref": "#/$defs/boundedNonBlankString" },
        {
          "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
        }
      ]
    },
    "replaceTextOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "anchorContains", "find", "replace"],
      "properties": {
        "op": { "const": "replaceText" },
        "anchorContains": { "$ref": "#/$defs/boundedNonBlankString" },
        "find": { "$ref": "#/$defs/boundedNonBlankString" },
        "replace": { "$ref": "#/$defs/boundedNonBlankString" },
        "tracked": { "type": "boolean" },
        "author": { "$ref": "#/$defs/boundedNonBlankString" }
      },
      "allOf": [
        {
          "if": { "properties": { "tracked": { "const": true } }, "required": ["tracked"] },
          "then": { "required": ["author"] }
        }
      ]
    },
    "replaceTableCellOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "row", "column", "text"],
      "properties": {
        "op": { "const": "replaceTableCell" },
        "author": { "$ref": "#/$defs/boundedNonBlankString" },
        "row": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "column": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "text": { "$ref": "#/$defs/boundedNonBlankString" }
      }
    },
    "reviewerOperation": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/replaceTextOperation" },
            { "required": ["author"] }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/replaceTableCellOperation" },
            { "required": ["author"] }
          ]
        }
      ]
    },
    "consolidateOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "reviewers"],
      "properties": {
        "op": { "const": "consolidate" },
        "reviewers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/reviewerOperation" }
        }
      }
    },
    "operation": {
      "oneOf": [
        { "$ref": "#/$defs/replaceTextOperation" },
        { "$ref": "#/$defs/replaceTableCellOperation" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "afterAnchorContains", "styleId", "text"],
          "properties": {
            "op": { "const": "insertNumberedClause" },
            "afterAnchorContains": { "$ref": "#/$defs/boundedNonBlankString" },
            "styleId": { "$ref": "#/$defs/boundedNonBlankString" },
            "text": { "$ref": "#/$defs/boundedNonBlankString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "anchorContains", "spanText", "author", "comment", "initials", "replyAuthor", "reply", "replyInitials", "footnote", "bookmark", "linkText"],
          "properties": {
            "op": { "const": "addReviewBundle" },
            "anchorContains": { "$ref": "#/$defs/boundedNonBlankString" },
            "spanText": { "$ref": "#/$defs/boundedNonBlankString" },
            "author": { "$ref": "#/$defs/boundedNonBlankString" },
            "comment": { "$ref": "#/$defs/boundedNonBlankString" },
            "initials": { "$ref": "#/$defs/boundedNonBlankString" },
            "replyAuthor": { "$ref": "#/$defs/boundedNonBlankString" },
            "reply": { "$ref": "#/$defs/boundedNonBlankString" },
            "replyInitials": { "$ref": "#/$defs/boundedNonBlankString" },
            "footnote": { "$ref": "#/$defs/boundedNonBlankString" },
            "bookmark": { "$ref": "#/$defs/boundedNonBlankString" },
            "linkText": { "$ref": "#/$defs/boundedNonBlankString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "tag", "text"],
          "properties": {
            "op": { "const": "fillContentControl" },
            "tag": { "$ref": "#/$defs/boundedNonBlankString" },
            "text": { "$ref": "#/$defs/boundedNonBlankString" }
          }
        },
        { "$ref": "#/$defs/consolidateOperation" }
      ]
    },
    "expectedOutput": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "candidate-docx" },
            "mediaType": { "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
            "role": { "const": "candidate" }, "required": { "const": true }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "semantic-change-set-v1" }, "mediaType": { "const": "application/json" },
            "role": { "const": "verification" }, "required": { "const": true }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "after-html" }, "mediaType": { "const": "text/html" },
            "role": { "const": "review" }, "required": { "const": true }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "redline-docx" },
            "mediaType": { "const": "application/vnd.openxmlformats-officedocument.wordprocessingml.document" },
            "role": { "const": "review" }, "required": { "const": true }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "candidate-pdf" }, "mediaType": { "const": "application/pdf" },
            "role": { "const": "review" }, "required": { "const": false }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "candidate-package-manifest-v1" }, "mediaType": { "const": "application/json" },
            "role": { "const": "verification" }, "required": { "const": true }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "deliverable-verification-v1" }, "mediaType": { "const": "application/json" },
            "role": { "const": "verification" }, "required": { "const": true }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "delivery-change-receipt-v1" }, "mediaType": { "const": "application/json" },
            "role": { "const": "verification" }, "required": { "type": "boolean" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "mediaType", "role", "required"],
          "properties": {
            "id": { "const": "redline-reversibility-proof-v1" }, "mediaType": { "const": "application/json" },
            "role": { "const": "verification" }, "required": { "type": "boolean" }
          }
        }
      ]
    },
    "numericInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "deterministic", "probe", "operator", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/boundedNonBlankString" },
        "metric": { "enum": ["task_completion", "target_precision", "unintended_change", "document_validity", "redline_reversibility", "rendering_regression"] },
        "deterministic": { "const": true },
        "probe": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "part", "xpath"],
              "properties": {
                "kind": { "const": "xmlCount" },
                "part": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^/" },
                "xpath": { "$ref": "#/$defs/boundedNonBlankString" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text"],
              "properties": {
                "kind": { "const": "textCount" },
                "text": { "$ref": "#/$defs/boundedNonBlankString" }
              }
            }
          ]
        },
        "operator": { "enum": ["equals", "atLeast"] },
        "expected": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    },
    "partExistsInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "deterministic", "probe", "operator", "expected"],
      "properties": {
        "id": { "$ref": "#/$defs/boundedNonBlankString" },
        "metric": { "enum": ["task_completion", "target_precision", "unintended_change", "document_validity", "redline_reversibility", "rendering_regression"] },
        "deterministic": { "const": true },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "part"],
          "properties": {
            "kind": { "const": "partExists" },
            "part": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^/" }
          }
        },
        "operator": { "const": "equals" },
        "expected": { "type": "boolean" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "tier",
    "fixture",
    "expectedDocument",
    "instruction",
    "redlineReversibility",
    "expectedOutputs",
    "baseline",
    "invariants",
    "changeBudget"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "not": { "enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"] }
    },
    "title": { "$ref": "#/$defs/boundedNonBlankString" },
    "tier": { "enum": ["fast", "full"] },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "provenanceId", "sourceSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/corpusRelativePath" },
        "provenanceId": { "$ref": "#/$defs/boundedNonBlankString" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "expectedDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "provenanceId", "sourceSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/corpusRelativePath" },
        "provenanceId": { "$ref": "#/$defs/boundedNonBlankString" },
        "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "instruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "constraints"],
      "properties": {
        "text": { "$ref": "#/$defs/boundedNonBlankString" },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/boundedNonBlankString" }
        }
      }
    },
    "redlineReversibility": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability"],
          "properties": {
            "applicability": { "const": "required" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "reason"],
          "properties": {
            "applicability": { "const": "notApplicable" },
            "reason": { "$ref": "#/$defs/boundedNonBlankString" }
          }
        }
      ]
    },
    "expectedOutputs": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/expectedOutput" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "candidate-docx" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "semantic-change-set-v1" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "after-html" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "redline-docx" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "candidate-pdf" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "candidate-package-manifest-v1" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "deliverable-verification-v1" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "delivery-change-receipt-v1" } }, "required": ["id"] } },
        { "contains": { "properties": { "id": { "const": "redline-reversibility-proof-v1" } }, "required": ["id"] } }
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "operations"],
      "properties": {
        "executor": { "const": "scripted-session-v1" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/operation" },
          "allOf": [
            {
              "if": { "contains": { "properties": { "op": { "const": "consolidate" } }, "required": ["op"] } },
              "then": { "maxItems": 1 }
            }
          ]
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/numericInvariant" },
          { "$ref": "#/$defs/partExistsInvariant" }
        ]
      }
    },
    "changeBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedChangedParts", "allowedRelationshipOwners", "maximumChangedAnchors"],
      "properties": {
        "allowedChangedParts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^/(?!.*\\.\\.)" }
        },
        "allowedRelationshipOwners": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^/(?!.*\\.\\.)" }
        },
        "maximumChangedAnchors": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "baseline": {
            "properties": {
              "operations": {
                "contains": { "properties": { "op": { "const": "consolidate" } }, "required": ["op"] }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "expectedOutputs": {
            "contains": {
              "properties": {
                "id": { "const": "delivery-change-receipt-v1" },
                "required": { "const": false }
              },
              "required": ["id", "required"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectedOutputs": {
            "contains": {
              "properties": {
                "id": { "const": "delivery-change-receipt-v1" },
                "required": { "const": true }
              },
              "required": ["id", "required"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "redlineReversibility": {
            "properties": { "applicability": { "const": "required" } },
            "required": ["applicability"]
          }
        }
      },
      "then": {
        "properties": {
          "expectedOutputs": {
            "contains": {
              "properties": {
                "id": { "const": "redline-reversibility-proof-v1" },
                "required": { "const": true }
              },
              "required": ["id", "required"]
            }
          }
        }
      },
      "else": {
        "properties": {
          "expectedOutputs": {
            "contains": {
              "properties": {
                "id": { "const": "redline-reversibility-proof-v1" },
                "required": { "const": false }
              },
              "required": ["id", "required"]
            }
          }
        }
      }
    }
  ]
}
