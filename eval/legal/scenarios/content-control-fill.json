  },
  "invariants": [
    { "id": "control-filled", "metric": "task_completion", "deterministic": true, "probe": { "kind": "xmlCount", "part": "/word/document.xml", "xpath": "//w:sdt[w:sdtPr/w:tag[@w:val='ClientLegalName']][.//w:t='Acme Manufacturing LLC']" }, "operator": "equals", "expected": 1 },
