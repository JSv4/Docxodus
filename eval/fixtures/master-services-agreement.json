    {
      "tool": "docxodus_edit",
      "target": {
        "mode": "text",
        "query": "invoiced quarterly in advance"
      },
      "args": {
        "action": "replace_text_range",
        "find": "invoiced quarterly in advance.",
        "replace": "invoiced quarterly in advance, net forty-five (45) days.",
        "caseSensitive": true
      }
    },
    {
      "tool": "docxodus_track_changes",
      "args": {
        "action": "set_mode",
        "mode": "accept",
        "revisionAuthor": ""
      }
    }
