      "target": {
        "mode": "text",
        "query": "MASTER SERVICES AGREEMENT",
        "as": "bodyAnchorId"
      },
      "args": {
        "action": "set_footer_text",
        "markdown": "Confidential",
        "kind": "default"
      }
    },
    {
      "tool": "docxodus_create",
      "target": {
        "mode": "text",
        "query": "Confidential",
        "scope": "footers"
