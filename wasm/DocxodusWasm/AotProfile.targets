<Project>
  <!-- The cache key: the SHA-256 of the selected profile, or "full-aot" without one. -->
  <Target Name="ComputeDocxodusAotProfileKey">
    <PropertyGroup>
      <_DocxodusAotProfileKey>full-aot</_DocxodusAotProfileKey>
    </PropertyGroup>
    <GetFileHash Files="$(WasmAotProfilePath)" Algorithm="SHA256"
                 Condition="'$(WasmAotProfilePath)' != ''">
      <Output TaskParameter="Items" ItemName="_DocxodusAotProfileFile" />
    </GetFileHash>
    <PropertyGroup Condition="'@(_DocxodusAotProfileFile)' != ''">
      <_DocxodusAotProfileKey>@(_DocxodusAotProfileFile->'%(FileHash)', '|')</_DocxodusAotProfileKey>
    </PropertyGroup>
  </Target>

  <!-- Mono's AOT up-to-date check compares assemblies with their bitcode outputs,
       but does not track profile contents, and ILStrip's check is mtime-only. Invalidate
       the generated AOT files and the stripped assemblies (whose zeroed IL bodies must
       match the compiled method set) when the selected profile changes; native runtime
       sources remain reusable. -->
  <Target Name="InvalidateDocxodusAotProfileCache"
          BeforeTargets="_WasmAotCompileApp"
          DependsOnTargets="ComputeDocxodusAotProfileKey"
          Condition="'$(_WasmShouldAOT)' == 'true'">
    <Error Condition="'$(_WasmIntermediateOutputPath)' == ''"
           Text="_WasmIntermediateOutputPath is empty: the WebAssembly SDK layout changed; update AotProfile.targets." />
    <PropertyGroup>
      <_DocxodusAotProfileStamp>$(_WasmIntermediateOutputPath)docxodus-aot-profile.sha256</_DocxodusAotProfileStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_DocxodusAotProfileStamp)"
                       Condition="Exists('$(_DocxodusAotProfileStamp)')">
      <Output TaskParameter="Lines" ItemName="_DocxodusPreviousAotProfile" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_DocxodusAotProfileChanged Condition="'@(_DocxodusPreviousAotProfile)' != '$(_DocxodusAotProfileKey)'">true</_DocxodusAotProfileChanged>
    </PropertyGroup>
    <ItemGroup Condition="'$(_DocxodusAotProfileChanged)' == 'true'">
      <_DocxodusStaleAotFile Include="$(_WasmIntermediateOutputPath)*.dll.bc;
                                     $(_WasmIntermediateOutputPath)*.dll.o;
                                     $(_WasmIntermediateOutputPath)aot_compiler_cache.json;
                                     $(_WasmIntermediateOutputPath)monoAotPropertyValues.txt" />
    </ItemGroup>
    <Message Text="AOT profile changed: invalidating compiled method selection."
             Importance="High" Condition="'$(_DocxodusAotProfileChanged)' == 'true'" />
    <Delete Files="@(_DocxodusStaleAotFile)" />
    <RemoveDir Directories="$(_WasmIntermediateOutputPath)tokens;$(_WasmIntermediateOutputPath)stripped"
               Condition="'$(_DocxodusAotProfileChanged)' == 'true'" />
  </Target>

  <!-- A failed compilation must not mark the new profile as successfully built. -->
  <Target Name="RecordDocxodusAotProfileCache"
          AfterTargets="_WasmAotCompileApp"
          Condition="'$(_WasmShouldAOT)' == 'true'">
    <WriteLinesToFile File="$(_DocxodusAotProfileStamp)" Lines="$(_DocxodusAotProfileKey)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_DocxodusAotProfileStamp)" />
    </ItemGroup>
  </Target>

  <!-- The two hooks above hang off private SDK targets and properties, which MSBuild lets
       vanish silently. This runs in the outer publish on public names only and fails if the
       nested publish did not record the current profile (the nested instance also runs
       Publish, before AOT, so it is excluded). The stamp path mirrors the SDK's
       nested-publish intermediate directory; if that moves, this fails closed rather than
       shipping AOT code compiled for a previous profile. -->
  <Target Name="VerifyDocxodusAotProfileCache"
          AfterTargets="Publish"
          DependsOnTargets="WasmTriggerPublishApp;ComputeDocxodusAotProfileKey"
          Condition="'$(RunAOTCompilation)' == 'true' and '$(WasmBuildingForNestedPublish)' != 'true'">
    <PropertyGroup>
      <_DocxodusPublishedAotProfileStamp>$(IntermediateOutputPath)wasm/for-publish/docxodus-aot-profile.sha256</_DocxodusPublishedAotProfileStamp>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_DocxodusPublishedAotProfileStamp)"
                       Condition="Exists('$(_DocxodusPublishedAotProfileStamp)')">
      <Output TaskParameter="Lines" ItemName="_DocxodusPublishedAotProfile" />
    </ReadLinesFromFile>
    <Error Condition="'@(_DocxodusPublishedAotProfile)' != '$(_DocxodusAotProfileKey)'"
           Text="The AOT profile cache was not recorded for the selected profile ($(_DocxodusPublishedAotProfileStamp) holds '@(_DocxodusPublishedAotProfile)', expected '$(_DocxodusAotProfileKey)'). The AotProfile.targets hooks did not run; check the WebAssembly SDK target names." />
  </Target>
</Project>
