<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable StyleCop for WASM wrapper -->
    <NoWarn>$(NoWarn);SA1633;SA1636</NoWarn>

    <!-- WASM specific -->
    <WasmMainJSPath>main.js</WasmMainJSPath>

    <!-- Size optimization -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- IL Trimming — only code reachable from the [JSExport] bridge surface ships.
         Docxodus and DocumentFormat.OpenXml are trimmed (see the ItemGroup below);
         modules never exported to the browser (PresentationBuilder, SpreadsheetWriter,
         HtmlToWml, DocumentBuilder, ...) are removed. Validated by the full Playwright
         suite plus tests/trim-validation.spec.ts, which pins the two paths where
         trimming could bite at runtime (reflective GetPackage(), OpenXmlValidator).
         See docs/architecture/wasm-packaging.md. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <!-- The timezone database is dead weight: nothing in the library converts timezones. -->
    <InvariantTimezone>true</InvariantTimezone>
    <!-- No dotnet.native.js.symbols in the payload. -->
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <!-- Suppressed deliberately: the only reflection in the WASM-compiled tree is
         PtOpenXmlUtil.GetPackage() (SDK 3.x Package access), whose targets are pinned
         by ILLink.Descriptors.xml. Trim safety is enforced by the browser test suite. -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>

    <!-- Webcil format (size-neutral vs .dll; firewall/AV-friendly) -->
    <WasmEnableWebcil>true</WasmEnableWebcil>

    <!-- Disable unused runtime features -->
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>

    <!-- Debug settings - disable for release -->
    <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>
    <EventSourceSupport Condition="'$(Configuration)' == 'Release'">false</EventSourceSupport>

    <!-- AOT Compilation DISABLED for smaller bundle size -->
    <!-- JIT/interpreter mode is slower at startup but bundle is ~50% smaller -->
    <!-- <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation> -->

    <!-- Define WASM_BUILD to enable SkiaSharp-free code paths in Docxodus -->
    <DefineConstants>$(DefineConstants);WASM_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference Docxodus library with WASM_BUILD property to exclude SkiaSharp dependencies -->
    <ProjectReference Include="../../Docxodus/Docxodus.csproj" AdditionalProperties="WASM_BUILD=true" />

    <!-- SkiaSharp DISABLED for smaller bundle size -->
    <!-- The WASM converter doesn't use ImageHandler, so SkiaSharp is not needed -->
    <!-- Uncomment if image processing is required -->
    <!-- <PackageReference Include="SkiaSharp" Version="2.88.9" /> -->
    <!-- <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="2.88.9" /> -->
  </ItemGroup>

  <!-- Native SkiaSharp library DISABLED - saves ~15MB -->
  <!-- <ItemGroup>
    <NativeFileReference Include="$(NuGetPackageRoot)skiasharp.nativeassets.webassembly/2.88.9/build/netstandard1.0/libSkiaSharp.a/3.1.34/simd,st/libSkiaSharp.a" />
  </ItemGroup> -->

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="main.js" />
    <WasmExtraFilesToDeploy Include="index.html" />
  </ItemGroup>

  <!-- Trimming roots. DocxodusWasm must stay fully rooted — JS resolves its [JSExport]s
       by name at runtime, invisibly to the trimmer. Docxodus and the Open XML SDK are
       opted INTO trimming instead (DocumentFormat.OpenXml is IsTrimmable-annotated, but
       under a rooted Docxodus most of it stayed reachable; Docxodus itself carries no
       IsTrimmable metadata, so TrimmableAssembly is required for it in either TrimMode).
       ILLink.Descriptors.xml pins the members PtOpenXmlUtil.GetPackage() reaches only
       via reflection. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="DocxodusWasm" />
    <TrimmableAssembly Include="Docxodus" />
    <TrimmableAssembly Include="DocumentFormat.OpenXml" />
    <TrimmableAssembly Include="DocumentFormat.OpenXml.Framework" />
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>
</Project>
