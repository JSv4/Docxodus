                "$ref": "#/$defs/page"
              }
            },
            "bindings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pageMapDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "htmlDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "pdfDigest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "artifactRequestIds": {
                  "type": "array",
