              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "verification"
                ],
                "properties": {
                  "verification": {
                    "const": "callerAttested"
                  }
                }
              },
              "then": {
                "required": [
                  "attested",
                  "attestationDigest"
                ]
              }
            }
          ]
