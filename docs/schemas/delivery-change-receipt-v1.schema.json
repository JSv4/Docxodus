          "type": "string",
          "minLength": 1
        },
        "fragmentIndex": {
          "$ref": "#/$defs/nonNegativeInt32"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "geometry": {
          "$ref": "#/$defs/pageMapRect"
        },
        "story": {
          "enum": [
            "body",
            "header",
            "footer",
            "footnote",
            "endnote",
            "comment"
          ]
