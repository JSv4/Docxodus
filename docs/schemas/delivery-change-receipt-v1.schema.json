        "scope": {
          "type": "string",
          "minLength": 1
        },
        "documentVersion": {
          "$ref": "#/$defs/portableInteger"
        },
        "packageDigest": {
          "$ref": "#/$defs/digest"
        },
        "rendererFingerprint": {
          "type": "string",
          "minLength": 1
        },
        "pageMapDigest": {
          "$ref": "#/$defs/digest"
        },
        "pageMapArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "renderArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "renderArtifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
