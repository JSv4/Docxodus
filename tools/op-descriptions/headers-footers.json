      "op": "setHeaderText",
      "facade": "SetHeaderText",
      "result": "EditResult",
      "args": [
        { "name": "bodyAnchorId", "type": "anchor", "required": true },
        { "name": "kind", "type": "enum", "required": true, "values": ["default", "first", "even"] },
        { "name": "markdown", "type": "markdown", "required": true }
      ],
      "transports": {
        "wasm": { "method": "SetHeaderText" },
        "npm": { "method": "setHeaderText" },
        "python": { "method": "set_header_text" },
        "stdio": { "op": "set_header_text" },
        "mcp": { "tool": "docxodus_create", "action": "set_header_text" }
      }
    },
    {
      "op": "setFooterText",
