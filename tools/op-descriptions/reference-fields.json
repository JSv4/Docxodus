        "mcp": { "tool": "docxodus_create", "action": "insert_table_of_figures", "flatAliases": { "options": { "captionLabel": "captionLabel", "hyperlinks": "hyperlinks", "rightTabPos": "rightTabPos" } } }
      }
    },
    {
      "op": "insertTableOfAuthorities",
      "facade": "InsertTableOfAuthorities",
      "result": "EditResult",
