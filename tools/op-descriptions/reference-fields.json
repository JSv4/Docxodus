{
  "$comment": "One description of the reference-field session ops (issue #982). See docs/architecture/session_op_descriptions.md. Argument names are the canonical wire names; argNames, defaults and requires on a transport are recorded divergences, not the target. flatAliases (on mcp) records the deprecated flat top-level MCP properties that still alias fields of the object argument MCP now takes nested (issue #1025): argument -> (field -> MCP property). tools/mcp-server/ObjectArguments.cs is the code they are checked against; no new flat alias should be added.",
  "family": "reference-fields",
  "ops": [
    {
      "op": "insertTableOfContents",
      "facade": "InsertTableOfContents",
      "result": "EditResult",
      "args": [
        { "name": "anchorId", "type": "anchor", "required": true },
        { "name": "position", "type": "position", "required": false, "default": "before" },
        { "name": "options", "type": "object", "required": false }
      ],
      "transports": {
        "wasm": { "method": "InsertTableOfContents" },
        "npm": { "method": "insertTableOfContents" },
        "python": { "method": "insert_table_of_contents", "argsFrom": "session.py:_insert_reference_field" },
        "stdio": { "op": "insert_table_of_contents" },
        "mcp": { "tool": "docxodus_create", "action": "insert_table_of_contents", "flatAliases": { "options": { "levels": "levels", "hyperlinks": "hyperlinks", "title": "title", "rightTabPos": "rightTabPos", "hideTabAndPageNumbersInWeb": "hideTabAndPageNumbersInWeb", "useOutlineLevels": "useOutlineLevels" } }, "$comment": "The flat hideTabAndPageNumbersInWeb and useOutlineLevels were read but never advertised; the schema advertises them only as options fields." }
      }
    },
    {
