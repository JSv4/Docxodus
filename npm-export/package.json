{
  "name": "@docxodus/export",
  "version": "0.0.0",
  "description": "Deterministic standalone HTML and PDF export for Docxodus through pinned Chromium",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "docxodus": "./dist/cli.js",
    "docxodus-export-host": "./dist/host.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:package-boundary": "node scripts/check-package-boundary.mjs",
    "prepack": "npm run build && npm run test:package-boundary"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@playwright/browser-chromium": "1.57.0",
    "fontkit": "2.0.4",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.57.0"
  },
  "peerDependencies": {
    "docxodus": "0.0.0"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "22.18.0",
    "docxodus": "file:../npm",
    "pdfjs-dist": "6.2.108",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSv4/Docxodus.git"
  },
  "keywords": [
    "docx",
    "pdf",
    "document-conversion",
    "chromium",
    "playwright"
  ],
  "author": "John Scrudato IV",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JSv4/Docxodus/issues"
  },
  "homepage": "https://github.com/JSv4/Docxodus#readme"
}
