<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Docxodus.Tests</AssemblyName>
    <DocxodusRepository Condition="'$(DocxodusRepository)' == ''">$(MSBuildThisFileDirectory)../..</DocxodusRepository>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="$(DocxodusRepository)/Docxodus/Docxodus.csproj" />
  </ItemGroup>
</Project>
